# gpt-image-tool configuration. The DEFAULT "subscription" backend needs NOTHING here —
# it reads your Codex/ChatGPT login from ~/.codex/auth.json. These are all optional.

# Only required for the paid "apikey" backend (standard OpenAI Images API):
OPENAI_API_KEY=

# --- Optional overrides ---
# GPT_IMAGE_BACKEND=subscription      # subscription (default) | apikey
# GPT_IMAGE_MODEL=gpt-5.5             # routing model for the subscription backend
# GPT_IMAGE_API_MODEL=gpt-image-1    # model for the apikey backend
# GPT_IMAGE_OUTPUT_DIR=              # default save directory
# GPT_IMAGE_INLINE=1                 # also return the image inline (base64) in MCP results
# GPT_IMAGE_TIMEOUT_MS=300000        # total request timeout
# GPT_IMAGE_STALL_MS=120000          # abort if the stream stalls this long
# CODEX_HOME=                        # override ~/.codex location (for both Codex and this tool)

# Pin the image tool to a SPECIFIC account, independent of your main `codex` login.
# Point this at a copy of an auth.json for the account you want images billed to. Lets your
# Codex coding use a different account (~/.codex) while images keep using this one.
# GPT_IMAGE_AUTH_FILE=C:/Users/matos/.codex-image/auth.json

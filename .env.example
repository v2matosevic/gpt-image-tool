# Optional gpt-image-tool configuration. Subscription reads your local Codex login.
# This file is documentation, not loaded automatically. Use Node --env-file=.env
# or set variables in the environment that launches the CLI / MCP client.

# Only required for the paid "apikey" backend (standard OpenAI Images API):
OPENAI_API_KEY=

# --- Optional overrides ---
# GPT_IMAGE_BACKEND=subscription      # subscription (default) | apikey
# GPT_IMAGE_MODEL=gpt-5.6-terra       # routing model for the subscription backend (sol|terra|luna tiers)
# GPT_IMAGE_KEEP_METADATA=1           # keep EXIF/XMP/C2PA in saved images (stripped by default)
# GPT_IMAGE_API_MODEL=gpt-image-1    # model for the apikey backend
# GPT_IMAGE_OUTPUT_DIR=              # default save directory
# GPT_IMAGE_INLINE=1                 # also return the image inline (base64) in MCP results
# GPT_IMAGE_TIMEOUT_MS=300000        # total request timeout
# GPT_IMAGE_STALL_MS=120000          # abort if the stream stalls this long
# GPT_IMAGE_MAX_RETRIES=3            # auto-retries on 429 (rate limit) / 5xx / network, with backoff
# GPT_IMAGE_PROFILE=                 # explicit path to a .gptimage.json brand profile (else auto-found)
# GPT_IMAGE_NO_SIDECAR=1             # disable writing a <image>.json sidecar next to each output
# CODEX_HOME=                        # override ~/.codex location (for both Codex and this tool)

# Optional existing credential file. Prefer the active Codex login over copied tokens.
# Never commit the file or put its contents into client configuration.
# GPT_IMAGE_AUTH_FILE=/absolute/path/to/auth.json

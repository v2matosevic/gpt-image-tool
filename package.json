{
  "name": "gpt-image-tool",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Generate images via your ChatGPT/Codex subscription (no API cost), exposed as an MCP tool + CLI for any LLM agent (Claude Code, Codex, Cursor, ...).",
  "bin": {
    "gpt-image": "dist/cli.js"
  },
  "files": ["dist", "README.md", ".env.example"],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v2matosevic/gpt-image-tool.git"
  },
  "scripts": {
    "build": "tsc",
    "mcp": "node dist/mcp.js",
    "cli": "node dist/cli.js",
    "check": "node dist/cli.js --check",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "dev:cli": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
